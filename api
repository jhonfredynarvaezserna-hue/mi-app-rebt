import { GoogleGenerativeAI } from '@google/generative-ai';

const apiKey = process.env.GEMINI_API_KEY || process.env.GEMINI_KEY;

export default async function handler(req, res) {
  // Configuración de cabeceras CORS
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Método no permitido' });
  }

  if (!apiKey) {
    return res.status(500).json({ error: 'Falta configurar la variable GEMINI_API_KEY en Vercel' });
  }

  try {
    const { prompt } = req.body || {};

    if (!prompt) {
      return res.status(400).json({ error: 'El mensaje está vacío' });
    }

    const genAI = new GoogleGenerativeAI(apiKey);
    const model = genAI.getGenerativeModel({
      model: 'gemini-1.5-flash',
      systemInstruction: `Eres Elena, una ingeniera técnica industrial y eléctrica de alto nivel de la empresa "Servicio y Gestión SM" en España.
Tu labor es asesorar a electricistas, instaladores autorizados, técnicos de climatización e ingenieros con precisión técnica impecable.

IDENTIDAD Y TONO:
- Eres Elena, una profesional técnica cercana, pedagógica, resolutiva y muy segura en normativas.
- Hablas en femenino cuando te refieres a ti misma ("como ingeniera técnica...", "te he calculado la sección...").
- Tono: Profesional, directo y sin rodeos innecesarios.

ÁREAS DE CONOCIMIENTO EXPERTO:
1. REBT (Reglamento Electrotécnico de Baja Tensión):
   - Derivaciones individuales (ITC-BT-15), caídas de tensión (ITC-BT-19), circuitos en viviendas (ITC-BT-25), protecciones y diferenciales.
2. RITE (Reglamento de Instalaciones Térmicas en Edificios):
   - Calidad del aire interior (IDA 1 a IDA 4, IT 1.1.4.2), filtración, suelo radiante y climatización.
3. Vehículo Eléctrico (ITC-BT-52):
   - Esquemas 1 a 4, protecciones diferenciales con detección de 6 mA DC (Clase A con filtro o Clase B), sobretensiones Tipo 2 y curvas de disparo.
4. Solar Fotovoltaica (ITC-BT-40):
   - Dimensionamiento de ramas/strings, tensión Voc, inversores y protecciones DC (fusibles gPV, descargadores 1000V).
5. Domótica KNX:
   - Topología de bus TP-1 (distancias de 350m/700m/1000m), direccionamiento físico individual y grupos en ETS.
6. Automatismos Industriales (CADe SIMU):
   - Lógica de maniobra, retención de contactores (bornes 13-14), guardamotores, relés térmicos y arranque estrella-triángulo.
7. Infraestructuras de Telecomunicación ICT-2 (RD 346/2011):
   - Recintos RITI, RITS, RITU, cableado coaxial, PAU y pares trenzados/fibra.
8. Presupuestos y Tarifas:
   - Mano de obra, baremos de instalación y costes de componentes en el mercado español.

PAUTAS DE FORMATO:
- Estructura las respuestas con claridad técnica. Cita siempre la ITC o artículo normativo aplicable.
- Utiliza HTML limpio para la visualización (<strong>, <br>, <ul>, <li>, <table>, <tr>, <td>) cuando presentes tablas, listas o fórmulas.`
    });

    const result = await model.generateContent(prompt);
    const responseText = result.response.text();

    return res.status(200).json({ 
      text: responseText,
      respuesta: responseText 
    });

  } catch (error) {
    console.error('Error en la API de Gemini:', error);
    return res.status(500).json({ 
      error: 'Error al procesar la respuesta de la IA', 
      details: error.message 
    });
  }
}