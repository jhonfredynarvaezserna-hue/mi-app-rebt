<!-- ==================== VISTA TRABAJOS ==================== -->
<section id="vista-trabajos" class="vista-section oculto">
    <header>
        <button type="button" class="btn-volver" onclick="abrirModuloDirecto('vista-inicio')">⬅ Volver al Menú</button>
        <h1>📸 Trabajos realizados</h1>
    </header>
    <div class="seccion-bloque">
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px;">

            <figure style="margin:0; background:var(--input-bg); border:1px solid var(--bordes); border-radius:8px; padding:10px; text-align:center;">
                <img src="fotos/cuadro-elda.jpg" alt="Cuadro eléctrico de vivienda" loading="lazy" style="width:100%; height:220px; object-fit:cover; border-radius:6px;">
                <figcaption style="font-size:.85rem; color:var(--azul-brillante); font-weight:bold; margin-top:10px;">Cuadro eléctrico de vivienda</figcaption>
            </figure>

            <figure style="margin:0; background:var(--input-bg); border:1px solid var(--bordes); border-radius:8px; padding:10px; text-align:center;">
                <img src="fotos/split-benidorm.jpg" alt="Instalación de aire acondicionado" loading="lazy" style="width:100%; height:220px; object-fit:cover; border-radius:6px;">
                <figcaption style="font-size:.85rem; color:var(--azul-brillante); font-weight:bold; margin-top:10px;">Instalación de aire acondicionado</figcaption>
            </figure>

        </div>
    </div>
</section>